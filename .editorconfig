# 모든 편집기(IntelliJ, VS Code 등)가 같은 기본 서식을 쓰도록 합니다. 자세한 규칙: dagong-matdagong/docs/coding-style.md
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.java]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
