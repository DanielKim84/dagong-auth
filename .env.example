# 회사·집 PC 개발은 Neon 공유 개발 DB를 씁니다. 실제로 넣을 값은
# dagong-matdagong/docs/home-development-setup.md 5-1을 따릅니다. 아래 localhost 값은 로컬 PostgreSQL 단독 실행용 예시입니다.
DB_URL=jdbc:postgresql://localhost:5432/dagong_auth
DB_USERNAME=dagong_auth
DB_PASSWORD=local_dev_only_change_me
AUTH_ISSUER=http://localhost:5840
# 로그인 화면은 React 개발 서버(4840)가 제공하고 인증 흐름은 Spring 서버(5840)가 처리합니다.
AUTH_LOGIN_PAGE_URL=http://localhost:4840/login
AUTH_LOGIN_SUCCESS_URL=http://localhost:4840/login?login=success
AUTH_LOGIN_FAILURE_URL=http://localhost:4840/login?error
AUTH_KEYSTORE_PASSWORD=generate_a_unique_local_password
AUTH_KEYSTORE_ALIAS=dagong-auth-signing
# 개발 PC에서만 토큰 수명을 늘립니다. 설정하지 않으면 30분(PT30M)입니다.
AUTH_ACCESS_TOKEN_TTL=PT8H
KAKAO_CLIENT_ID=replace_with_kakao_rest_api_key
KAKAO_CLIENT_SECRET=replace_with_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:4840/login/oauth2/code/kakao
